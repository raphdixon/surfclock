{
  "hosting": {
    "target": "surfclock",
    "public": "web_customizer",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "verify_*.png",
      "verify_*.jpg"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(glb|stl|zip)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  }
}
